# Leave MongoDB blank for zero-config local SQLite (data/annotator.db).
# Set MONGO_URI (or MONGO_USERNAME/PASSWORD/HOST) for MongoDB Atlas hosting.
STORAGE_BACKEND=auto
SQLITE_PATH=data/annotator.db

MONGO_URI=
MONGO_USERNAME=
MONGO_PASSWORD=
MONGO_HOST=
MONGO_DB=annotator_db

# Hugging Face token (required for gated foundation model paige-ai/Virchow2)
HF_TOKEN=

# Leave empty for open local login; set comma-separated usernames when hosting online
ALLOWED_USERS=
ANNOTATOR_SECRET_KEY=

# Paths & limits
SLIDES_DIR=./slides
CHECKPOINT=./weights/multihead_classifier.pth
MITOTIC_CHECKPOINT=./weights/mitotic_classifier.pth
MITOTIC_THRESHOLD=0.9
MAX_SLIDE_DIM=7000
HOST=127.0.0.1
PORT=5006
